{
  "name": "@mathvsk/obraprima-ui",
  "version": "0.1.0",
  "type": "module",
  "description": "Componentes React compartilhados entre o desktop e o mobile do Obra Prima, com CSS e tipos TypeScript.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mathvsk/obraprima-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./estilos.css": {
      "types": "./dist/estilos.css.d.ts",
      "default": "./dist/estilos.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/preparar-dist.mjs && tsc -p tsconfig.build.json",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run test && npm run typecheck && npm run lint && npm run check:package",
    "check:package": "node scripts/verificar-pacote.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.4"
  }
}
